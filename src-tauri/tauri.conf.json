{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rightmark",
  "version": "0.1.1",
  "identifier": "com.yiaany.folio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "rightmark",
        "width": 1060,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": { "x": 17, "y": 24 },
        "backgroundColor": "#141414"
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "width": 664,
        "height": 374,
        "visible": false,
        "focus": false,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/32x32.png"], "macOS": { "minimumSystemVersion": "13.0" } }
}
